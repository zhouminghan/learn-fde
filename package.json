{
  "name": "learn-fde",
  "version": "0.1.0",
  "private": true,
  "description": "腾讯云 ADP FDE 认证学习与能力训练站（简体中文）",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vitepress dev docs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run --config tests/config/vitest.config.ts",
    "test:watch": "vitest --config tests/config/vitest.config.ts",
    "test:e2e": "playwright test --config tests/config/playwright.config.ts --project=chromium --project=mobile",
    "test:e2e:all": "playwright test --config tests/config/playwright.config.ts",
    "test:visual": "playwright test --config tests/config/playwright.config.ts --project=visual",
    "content:validate": "node --import tsx scripts/validate-content.ts",
    "content:check-duplicates": "node --import tsx scripts/check-duplicates.ts",
    "verify": "npm run typecheck && npm run test && npm run content:validate && npm run docs:build && npm run test:e2e",
    "verify:full": "npm run verify && npm run test:visual"
  },
  "dependencies": {
    "@lucide/vue": "^1.72.0",
    "dexie": "^4.0.11",
    "mermaid": "^11.4.1",
    "vitepress": "^1.6.3",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "axe-core": "^4.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10"
  }
}
